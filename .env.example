# ===========================================
# AMBIENTE DE DESENVOLVIMENTO
# ===========================================

# Gemini API (obrigatório)
GEMINI_API_KEY=sua-chave-gemini-aqui

# JWT Secret (obrigatório para autenticação)
JWT_SECRET=chave-secreta-desenvolvimento-123

# Mercado Pago (opcional em dev, necessário para pagamentos)
MERCADOPAGO_ACCESS_TOKEN=

# ===========================================
# AMBIENTE DE PRODUÇÃO
# Descomente e configure para produção
# ===========================================

# # PostgreSQL (apenas prod, dev usa padrão postgres/postgres)
# POSTGRES_PASSWORD=senha-segura-postgres

# # JWT Secret (IMPORTANTE: Use uma chave forte em produção!)
# JWT_SECRET=sua-chave-super-secreta-aleatoria-aqui

# # Mercado Pago Access Token (Production)
# MERCADOPAGO_ACCESS_TOKEN=seu-access-token-mercadopago

# # URLs (ajuste conforme seu domínio)
# FRONTEND_URL=https://tarom.com.br
# BACKEND_URL=https://api.tarom.com.br

# # Gemini API
# GEMINI_API_KEY=sua-chave-gemini-aqui

